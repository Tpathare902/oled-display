#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET    -1
#define SCREEN_ADDRESS 0x3C 

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// Background Plankton/Bubbles
#define NUM_PARTICLES 15
float pX[NUM_PARTICLES];
float pY[NUM_PARTICLES];
float pSpeed[NUM_PARTICLES];

void setup() {
  Serial.begin(115200);
  if(!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    Serial.println(F("SSD1306 allocation failed"));
    for(;;);
  }

  // Scatter particles randomly
  for(int i = 0; i < NUM_PARTICLES; i++) {
    pX[i] = random(0, 128);
    pY[i] = random(0, 64);
    pSpeed[i] = random(2, 8) / 10.0; // Slow, varying speeds
  }
}

void loop() {
  display.clearDisplay();

  // A floating time variable to drive all the math waves
  float time = millis() / 1000.0;

  // --- 1. Background Environment ---
  for (int i = 0; i < NUM_PARTICLES; i++) {
    display.drawPixel(pX[i], pY[i], SSD1306_WHITE);
    pY[i] -= pSpeed[i]; // Float upward
    
    // Add a tiny horizontal drift to the particles
    pX[i] += sin(time + i) * 0.5;

    // Wrap around to the bottom when they hit the surface
    if (pY[i] < 0) {
      pY[i] = 64;
      pX[i] = random(0, 128);
    }
  }

  // --- 2. Jellyfish Core Physics ---
  // The 'pulse' drives the swimming animation (-1.0 to 1.0)
  float pulse = sin(time * 2.5); 
  
  // The body slowly bobs up and down
  int jellyX = 64;
  int jellyY = 25 + (sin(time * 1.2) * 6); 

  // The dome stretches and squashes based on the pulse
  int domeWidth = 22 + (pulse * 3);
  int domeHeight = 12 - (pulse * 2);

  // --- 3. Draw the Bell (Dome) ---
  // We calculate a mathematical ellipse and draw it line by line
  for (int dy = 0; dy < domeHeight; dy++) {
     // Equation of an ellipse solved for X
     int dx = domeWidth * sqrt(1.0 - (float)(dy * dy) / (domeHeight * domeHeight));
     display.drawFastHLine(jellyX - dx, jellyY - dy, dx * 2, SSD1306_WHITE);
  }
  
  // Hollow out the inside of the bell to give it a glass/translucent look
  for (int dy = 0; dy < domeHeight - 2; dy++) {
     int dx = (domeWidth - 3) * sqrt(1.0 - (float)(dy * dy) / ((domeHeight - 2) * (domeHeight - 2)));
     display.drawFastHLine(jellyX - dx, (jellyY + 1) - dy, dx * 2, SSD1306_BLACK);
  }

  // --- 4. Draw the Kinematic Tentacles ---
  // 5 tentacles spread evenly across the bottom of the bell
  for (int i = -2; i <= 2; i++) {
    int startX = jellyX + (i * (domeWidth / 2.5));
    int startY = jellyY;

    float prevX = startX;
    float prevY = startY;

    // Draw each tentacle in segments to allow it to curve
    for (int step = 1; step <= 22; step++) {
       int currentY = startY + step;
       
       // The magic rippling formula: 
       // Combines runtime, the vertical position of the segment, and the tentacle index
       float ripple = sin(time * 4.0 + (step * 0.3) + (i * 0.8)) * (3.0 + (step * 0.1));
       
       // When the jellyfish pulses, the tentacles pull inward
       float contraction = (pulse * i * 1.5);
       
       float currentX = startX + ripple - contraction;

       display.drawLine(prevX, prevY, currentX, currentY, SSD1306_WHITE);
       
       prevX = currentX;
       prevY = currentY;
    }
  }

  display.display();
  delay(20); 
}
